<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
      http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
      http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
      http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <configuration-properties file="application.properties"/>

    <!-- Process API Listener -->
    <http:listener-config name="HTTP_Listener_config">
        <http:listener-connection
            host="0.0.0.0"
            port="${http.port}"/>
    </http:listener-config>

    <!-- Country System API -->
    <http:request-config name="Country_Request_Config">
        <http:request-connection
            host="${country.host}"
            port="${country.port}"
            protocol="${country.protocol}"/>
    </http:request-config>

    <!-- Weather System API -->
    <http:request-config name="Weather_Request_Config">
        <http:request-connection
            host="${weather.host}"
            port="${weather.port}"
            protocol="${weather.protocol}"/>
    </http:request-config>

    <!-- Exchange System API -->
    <http:request-config name="Exchange_Request_Config">
        <http:request-connection
            host="${exchange.host}"
            port="${exchange.port}"
            protocol="${exchange.protocol}"/>
    </http:request-config>

    <flow name="travel-process-apiFlow">

        <http:listener
            config-ref="HTTP_Listener_config"
            path="/travel/{country}"
            doc:name="Travel Process Listener">

            <http:response statusCode="200"/>

            <http:error-response
                statusCode="#[if (error.errorType.namespace == 'APP' and error.errorType.identifier == 'INVALID_COUNTRY') 404 else 502]">
                <http:body>#[payload]</http:body>
            </http:error-response>

        </http:listener>

        <logger
            level="INFO"
            message="#['Requested country: ' ++ attributes.uriParams.country]"
            doc:name="Log Country Request"/>

        <try doc:name="Travel API Processing">

            <!-- Country System API -->
            <http:request
                method="GET"
                config-ref="Country_Request_Config"
                path="#['/countries/' ++ attributes.uriParams.country]"
                doc:name="Country Request"/>

            <set-variable
                variableName="countryData"
                value="#[payload]"
                doc:name="Save Country Data"/>

            <choice doc:name="Validate Country">
                <when expression="#[isEmpty(vars.countryData.countryName default '')]">
                    <raise-error
                        type="APP:INVALID_COUNTRY"
                        description="Country not found. Please provide a valid country name."
                        doc:name="Invalid Country"/>
                </when>
            </choice>

            <!-- Weather System API -->
            <http:request
                method="GET"
                config-ref="Weather_Request_Config"
                path="#['/weather/' ++ (vars.countryData.countryName as String)]"
                doc:name="Weather Request"/>

            <set-variable
                variableName="weatherData"
                value="#[payload]"
                doc:name="Save Weather Data"/>

            <!-- Exchange System API -->
            <http:request
                method="GET"
                config-ref="Exchange_Request_Config"
                path="#['/exchange/' ++ vars.countryData.currencyCode]"
                doc:name="Exchange Rate Request"/>

            <!-- Combine all responses -->
            <set-payload
                mimeType="application/json"
                value="#[output application/json
                ---
                {
                    countryInformation: vars.countryData,
                    weatherInformation: vars.weatherData,
                    currencyInformation: payload
                }]"
                doc:name="Combine Travel Information"/>

            <error-handler>
                <on-error-propagate
                    type="ANY"
                    logException="true"
                    doc:name="Travel API Error Handler">

                    <logger
                        level="ERROR"
                        message="#['Travel API failed: ' ++ error.description]"
                        doc:name="Log Travel API Error"/>

                    <set-payload
                        mimeType="application/json"
                        value="#[output application/json
                        ---
                        if (error.errorType.namespace == 'APP' and error.errorType.identifier == 'INVALID_COUNTRY')
                        {
                            error: 'Country not found',
                            message: 'Please provide a valid country name.'
                        }
                        else
                        {
                            error: 'Travel information service failed',
                            message: 'Unable to retrieve the requested travel information.'
                        }]"
                        doc:name="Set Error Response"/>

                </on-error-propagate>
            </error-handler>

        </try>

    </flow>

</mule>
